<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for pictures that other apps give to Watch Next and their channels. No analytics, ads or tracking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The network icon and VPN badge. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Other apps' Watch Next items and home screen channels (a runtime permission, asked for in Settings). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- The recent apps panel (a double Home press): usage access, given once in Android settings or with adb. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Android 9 only: saving the backup to Download/MyTVLauncher (later versions need no permission for it). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- A TV-only app (the owner, 2026-11-18): Google Play offers it only to Android TV and Google TV devices. A
         sideloaded APK still installs anywhere. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11 and later show an app only the apps it asks for: the apps a launcher can open. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Which apps can choose a file (Settings › Backup & restore): the TV's own picker, or a file manager. -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: pictures that apps give to Watch Next and their channels can come from a media server on
         the home network over plain HTTP (Plex and Plezy do, the owner, 2026-11-15). Pictures are the launcher's only
         network use. -->
    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyTVLauncher"
        android:usesCleartextTraffic="true">

        <!-- The home screen: HOME + DEFAULT make it a home app. singleTask, so that Home brings this one back. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- A backup file opened from a file manager ("Open with" or "Share"): for TVs whose file picker is missing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
            </intent-filter>
        </activity>

        <!-- System notifications for the top bar's bell (0.8.0). Off until Settings › Show notifications turns it on, so
             Android binds it only then, and only once the user gave notification access. -->
        <service
            android:name=".data.LauncherNotificationListener"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
